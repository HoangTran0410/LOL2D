    "poly-decomp": "^0.3.0",
    "sat": "^0.9.0",
    "uuid": "^9.0.1",
    "visibility-polygon": "^1.0.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/p5": "^1.7.6",
    "@types/sat": "^0.0.35",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.1"
  }
}
