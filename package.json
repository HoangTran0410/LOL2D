{
  "name": "lol2d",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:check": "node scripts/generate-assets.mjs --check",
    "predev": "npm run assets:generate",
    "dev": "vite",
    "prebuild": "npm run assets:generate",
    "build": "vite build",
    "preview": "vite preview",
