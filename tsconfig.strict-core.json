{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/game/spell/**/*.ts",
    "src/game/combat/**/*.ts",
    // The pure half of the touch layer — geometry, stick maths and aim
    // resolution. TouchControls.ts is deliberately not here: it draws, so it
    // reaches for p5 globals, and it is covered by the ordinary typecheck.
    "src/game/input/TouchLayout.ts",
    "src/game/input/VirtualJoystick.ts",
    "src/game/input/SpellAim.ts",
    "tests/game/spell/**/*.ts",
    "tests/game/combat/**/*.ts",
    "src/game/gameObject/spellObjects/**/*.ts",
    "src/game/gameObject/GameObject.ts",
    "src/game/gameObject/SpellObject.ts",
    "src/game/gameObject/Buff.ts",
    "src/game/gameObject/attackableUnits/AttackableUnit.ts",
    "src/game/gameObject/attackableUnits/Champion.ts",
    "src/game/gameObject/attackableUnits/AIChampion.ts",
    "src/game/gameObject/attackableUnits/DummyChampion.ts",
    "src/game/gameObject/attackableUnits/Monster.ts",
    "src/game/gameObject/structures/Turret.ts",
    "src/game/gameObject/structures/Fountain.ts",
    "src/game/gameObject/buffs/**/*.ts",
    "src/game/managers/ObjectManager.ts",
    "src/game/managers/UnitCollisionSystem.ts",
    "tests/game/UnitCollisionSystem.test.ts",
    // The seven individually-listed strict spells (Lux_R, Janna_R, Janna_Q,
    // Anivia_R, Varus_Q, Pantheon_Q, Malphite_Q) moved into `packs/riot/spells/`
    // in batch 4 task 3. `packs/**/*.ts` used to cover their new path here;
    // batch 5 task 2 moved that glob to the pack's own `tsconfig.pack-riot.json`
    // (wired into root `verify` as `typecheck:riot`, beside `typecheck:core`,
    // until batch 5 task 6 relocated it to `packs/riot/package.json`'s own
    // `typecheck` script, reached through the new `verify:all` instead — fix
    // round 2 then gave the pack its own self-contained `tsconfig.json`
    // rather than one living at this repo's own root). This program still
    // resolves ~255 pack files transitively regardless — see
    // the `exclude` block's own comment below for the real, structural
    // reason (`AIChampion.ts` -> `preset.ts` -> `spellRegistry.ts` ->
    // `@/content/install`, the permanent Stage 1 pack loader) — so "no pack
    // present" is not actually true of this config; only the *explicit*,
    // test-authoring-convenience reach is gone.
    "src/game/vfx/**/*.ts",
    "src/generated/**/*.ts",
    "src/managers/AssetManager.ts",
    // NOT `tests/game/spells/representative-spells.test.ts`: it imports real
    // pack spells by path (Anivia_R, Janna_Q, Janna_R, Lux_R, Malphite_Q,
    // Pantheon_Q, Varus_Q, ...) and is a test *about pack spells* — batch 5
    // task 2 fix round 1 moved its strict coverage out of this program
    // after finding it transitively pulled 256 of 257 pack files into this
    // one, defeating the point of the split above — task 6 fix round 2 gave
    // it `tsconfig.strict-core-boundary.json` instead of the pack's own
    // config, since it is core's own test file, not the pack's. Do not move
    // it back here.
    "tests/game/types/BaseObjectTypes.test.ts",
    "tests/game/types/BuffUnitTypes.test.ts",
    "tests/game/types/ChampionTypes.test.ts",
    "tests/game/config/spellCatalogId.types.test.ts",
    // `src/seams/` and the tests that certify it. The whole-branch review of
    // batch 5 measured `tsc --listFiles` for all three programs and found
    // **zero** files under `tests/seams/` in any of them — 900-odd lines,
    // most of them written by that batch, that nothing typechecked. The
    // consequence was already sitting in the tree: `exported-seams.test.ts`
    // imported `checkSpellRuntimeDrive` twice in one clause, which Node's own
    // ESM parser rejects outright (`SyntaxError`) and esbuild silently
    // dedupes, so the suite was green over a latent syntax error in the file
    // that certifies core's public seam exports. Here rather than in
    // `tsconfig.json` because `src/seams/` is pure TypeScript over `node:fs`
    // with no p5 global and no Vue in sight — the exact shape this strict
    // program exists for.
    "src/seams/**/*.ts",
    "tests/seams/**/*.ts"
  ],
  // The six paths below match `tests/game/spell/**/*.ts` or
  // `tests/game/combat/**/*.ts` above but are carved back out: `registry.ts`
  // value-imports the whole `packs/riot/spells/index` barrel (240+ files) to
  // fill the spell registry synchronously for tests, and the five `*.test.ts`
  // files import specific pack spells by path or (`AttackProfiles.test.ts`)
  // call `registry.ts`'s loader. Each is now an include root in
  // `tsconfig.strict-core-boundary.json` instead (renamed from
  // `tsconfig.pack-riot.json` in task 6 fix round 2, once the pack got a
  // real self-contained `tsconfig.json` of its own and this leftover set —
  // core's own test files, not the pack's — needed a name that says so), so
  // their own strict coverage does not drop; only which config owns it
  // changes.
  //
  // This does NOT bring this program's own `packs/` count to zero — it drops
  // it from 256 to 255 (`tsc --listFiles -p tsconfig.strict-core.json | grep
  // -c /packs/`). The other 255 are a separate, structural chain, not another
  // instance of this same leak: `AIChampion.ts` (a real include root above,
  // and genuine gameplay code — it calls `getChampionPresetRandom` at
  // runtime) imports `preset.ts`, which imports `spellRegistry.ts`, which
  // value-imports `BUNDLED_PACK_ID` from `@/content/install` — the Stage 1
  // pack loader `corePacksBoundary.test.ts` documents as "permanent, by
  // design." `install.ts` re-exports that constant from `packs/riot/pack`
  // itself (`import riotCode, { data, BUNDLED_PACK_ID } from
  // '../../packs/riot/pack'; export { BUNDLED_PACK_ID };`), and TypeScript
  // does not tree-shake a module for type-checking: importing one named
  // export still resolves everything else that file imports, including
  // `generated/spellModules.ts`'s 240 dynamic-import thunks — which is most
  // of `packs/riot/spells/`. Do not "fix" this by moving `AIChampion.ts` (or
  // anything upstream of it) out of this config — that is a real regression
  // in strict coverage of production gameplay code for the sake of a number.
  // See batch 5 task 2's fix-round-1 report for the full trace.
  "exclude": [
    "node_modules",
    "testzone",
    "tools",
    "dist",
    "tests/game/spell/registry.ts",
    "tests/game/combat/AttackProfiles.test.ts",
    "tests/game/combat/Pet.test.ts",
    "tests/game/combat/ExecuteMarks.test.ts",
    "tests/game/combat/Reach.test.ts",
    "tests/game/combat/Vision.test.ts"
  ]
}
